# ==========================================
# Career Navigator Backend Environment Config
# ==========================================

# Server Port (default 5000)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careernavigator?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careernavigator?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Environment Mode: development | production
NODE_ENV=development

# Optional: In-memory DB fallback for local offline testing (never use in production)
USE_IN_MEMORY_DB=false
